# Copy this file to .env and fill in your own key. Never commit .env.
#
# Free API key for Groq (https://console.groq.com) — used only as the
# Phase 2 supervisor's routing/reasoning LLM. No card required, no cost.
GROQ_API_KEY=

# Optional: override the default Groq model.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: use a different Groq model just for the Phase 3 guardrail
# judge calls (supervisor/guardrails.py). Defaults to GROQ_MODEL above.
# GROQ_JUDGE_MODEL=

# Optional: set to 0 to disable the Phase 3 LLM-judge guardrail layer
# entirely (the free, offline rule-based layer still runs). Useful for a
# fully offline demo, or to avoid Groq's free-tier rate limit.
# GUARDRAILS_LLM_JUDGE=1
